# Copie para .env.local. Nenhuma variável é obrigatória.

# Autentica as chamadas à GitHub API usadas na seção § 03 (Arquivo ao vivo).
# Sem ela o site funciona igual, apenas com o limite público de 60 req/hora —
# o cache de 1 hora (ISR) deixa isso confortável na maioria dos casos.
# Basta um Personal Access Token sem escopo algum (public_repo já é demais).
GITHUB_TOKEN=
